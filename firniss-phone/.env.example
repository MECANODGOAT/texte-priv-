# Copiez ce fichier en .env.local et remplissez les valeurs.

# Supabase > Project Settings > API Keys (bouton « Connect » pour l'URL)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Clé secrète : ne jamais la partager ni la mettre dans le code.
SUPABASE_SECRET_KEY=sb_secret_...
# (Les anciens noms NEXT_PUBLIC_SUPABASE_ANON_KEY et SUPABASE_SERVICE_ROLE_KEY fonctionnent aussi.)

# Numéro WhatsApp de la boutique, avec l'indicatif (ex. 212612345678 ou 24177123456)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Taux de conversion euro → dirham (le franc CFA a une parité fixe)
NEXT_PUBLIC_EUR_TO_MAD=10.8

# Facultatif : e-mail à chaque nouvelle commande (compte gratuit sur resend.com)
RESEND_API_KEY=
ADMIN_EMAIL=
EMAIL_FROM=
